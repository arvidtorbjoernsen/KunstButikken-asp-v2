import { isPlatformBrowser } from '@angular/common';
import { HttpClient, provideHttpClient, withFetch, withInterceptors } from '@angular/common/http';
import {
    ApplicationConfig,
    Inject,
    Injectable,
    PLATFORM_ID,
    importProvidersFrom,
    provideBrowserGlobalErrorListeners,
    provideZonelessChangeDetection
} from '@angular/core';
import { provideClientHydration, withEventReplay } from '@angular/platform-browser';
import { provideAnimationsAsync } from '@angular/platform-browser/animations/async';
import { provideRouter } from '@angular/router';
import {
    provideKeycloak,
    includeBearerTokenInterceptor,
    INCLUDE_BEARER_TOKEN_INTERCEPTOR_CONFIG,
    IncludeBearerTokenCondition
} from 'keycloak-angular';
import { TranslateLoader, TranslateModule, TranslationObject } from '@ngx-translate/core';
import { catchError, from, of } from 'rxjs';

import { environment } from '../environments/environment';
import { routes } from './app.routes';

@Injectable()
class AssetTranslateLoader implements TranslateLoader {
  constructor(private readonly http: HttpClient, @Inject(PLATFORM_ID) private readonly platformId: object) {}

  getTranslation(lang: string) {
    const safeLang = (lang ?? '').trim().toLowerCase();
    if (!safeLang) {
      return of({} as TranslationObject);
    }

    const assetPath = `/assets/i18n/${safeLang}.json`;

    if (isPlatformBrowser(this.platformId)) {
      return this.http.get<TranslationObject>(assetPath).pipe(
        catchError(() => of({} as TranslationObject))
      );
    }

    // Server-side: read from filesystem
    return from(
      (async () => {
        try {
          const fs = await import('fs/promises' as any);
          const path = await import('path' as any);

          const searchRoots = [
            path.join(process.cwd(), 'dist', 'KunstButikken.Frontend-Ang', 'browser', 'assets', 'i18n'),
            path.join(process.cwd(), 'src', 'assets', 'i18n')
          ];

          for (const root of searchRoots) {
            try {
              const fileContent = await fs.readFile(path.join(root, `${safeLang}.json`), 'utf8');
              return JSON.parse(fileContent) as TranslationObject;
            } catch {
              // try next location
            }
          }
        } catch {
          // ignore and fall through
        }

        return {} as TranslationObject;
      })()
    ).pipe(catchError(() => of({} as TranslationObject)));
  }
}

// Define condition for which URLs should receive the bearer token
// Match all backend API URLs (they go through the gateway)
const bearerTokenCondition: IncludeBearerTokenCondition = {
  urlPattern: /^http?:\/\/localhost:\d+\/api\/.*/i, // Matches all /api/* URLs
  // Optional: specify HTTP methods, if omitted, all methods are included
  // httpMethods: ['GET', 'POST', 'PUT', 'DELETE', 'PATCH']
};

export const appConfig: ApplicationConfig = {
  providers: [
    provideBrowserGlobalErrorListeners(),
    provideZonelessChangeDetection(),
    provideRouter(routes),
    // SSR enabled for SEO - art gallery needs indexing!
    provideClientHydration(withEventReplay()),
    provideAnimationsAsync(),

    // HTTP Client - with or without bearer token interceptor depending on environment
    ...(typeof window !== 'undefined'
      ? [
          // Browser: HTTP client with Keycloak bearer token interceptor
          provideHttpClient(
            withFetch(),
            withInterceptors([includeBearerTokenInterceptor])
          ),
          // Configure which URLs should receive the bearer token
          {
            provide: INCLUDE_BEARER_TOKEN_INTERCEPTOR_CONFIG,
            useValue: [bearerTokenCondition]
          },
          // Modern keycloak-angular v20+ configuration
          provideKeycloak({
            config: {
              url: environment.keycloak.baseUrl,
              realm: environment.keycloak.realm,
              clientId: environment.keycloak.clientId
            },
            initOptions: {
              onLoad: 'check-sso',
              // Don't use silentCheckSsoRedirectUri when checkLoginIframe is false
              // This prevents the iframe timeout error
              checkLoginIframe: false,
              // Use standard flow (authorization code)
              flow: 'standard',
              // Reduce timeout to fail faster if there are issues
              messageReceiveTimeout: 3000
            }
          })
        ]
      : [
          // SSR: HTTP client without interceptor (Keycloak not available)
          provideHttpClient(withFetch())
        ]),

    importProvidersFrom(
      TranslateModule.forRoot({
        fallbackLang: 'nb',
        loader: {
          provide: TranslateLoader,
          useClass: AssetTranslateLoader,
          deps: [HttpClient, PLATFORM_ID]
        }
      })
    )
  ]
};

