{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "admin-service-route": {
        "ClusterId": "admin-service-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "art-service-route": {
        "ClusterId": "art-service-cluster",
        "Match": {
          "Path": "/api/art/{**catch-all}"
        }
      },
      "auction-service-route": {
        "ClusterId": "auction-service-cluster",
        "Match": {
          "Path": "/api/auctions/{**catch-all}"
        }
      },
      "auction-hub-route": {
        "ClusterId": "auction-service-cluster",
        "Match": {
          "Path": "/hubs/auctions/{**catch-all}"
        }
      },
      "auction-hub-base-route": {
        "ClusterId": "auction-service-cluster",
        "Match": {
          "Path": "/hubs/auctions"
        }
      },
      "payment-service-route": {
        "ClusterId": "payment-service-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "user-service-route": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "admin-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://admin-service"
          }
        }
      },
      "art-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://art-service"
          }
        }
      },
      "auction-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auction-service"
          }
        },
        "HttpClient": {
          "WebSocketEnabled": "true"
        }
      },
      "payment-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payment-service"
          }
        }
      },
      "user-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-service"
          }
        }
      }
    }
  }
}
