<Project>
  <PropertyGroup>
    <!-- Repository root directory where this file lives. Use $(RepoRoot) in projects to build repo-root absolute paths. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- You can add shared props here (company, versioning, analyzer settings etc.) -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Emit repo root as assembly metadata so runtime code can read it via reflection -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(RepoRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
