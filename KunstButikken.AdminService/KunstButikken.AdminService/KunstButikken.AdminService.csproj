<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Scalar.AspNetCore"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../KunstButikken.ServiceDefaults/KunstButikken.ServiceDefaults.csproj"/>
        <ProjectReference Include="../../KunstButikken.IntegrationEvents.Contracts/KunstButikken.IntegrationEvents.Contracts.csproj"/>
        <ProjectReference Include="../../KunstButikken.Common.Logging/KunstButikken.Common.Logging.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Exclude Domain/Application/Infrastructure source files from the Web project to avoid duplicate compilation -->
        <Compile Remove="Domain\**\*.cs"/>
        <Compile Remove="Application\**\*.cs"/>
        <Compile Remove="Infrastructure\**\*.cs"/>
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>KunstButikken.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
