<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <PropertyGroup>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all"/>
        <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <!--        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>-->
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory"/>
        <PackageReference Include="Aspire.Keycloak.Authentication"/>
        <!--        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>-->
        <PackageReference Include="Scalar.Aspire"/>
<!--        <PackageReference Include="Scalar.AspNetCore"/>-->
        <PackageReference Include="Aspire.RabbitMQ.Client"/>
<!--        <PackageReference Include="RabbitMQ.Client"/>-->
        <PackageReference Include="Microsoft.Extensions.Http.Resilience"/>
<!--        <PackageReference Include="Polly"/>-->
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="Application/KunstButikken.AdminService.Application.csproj"/>
        <ProjectReference Include="Infrastructure/KunstButikken.AdminService.Infrastructure.csproj"/>
        <ProjectReference Include="$(RepoRoot)KunstButikken.IntegrationEvents.Contracts/KunstButikken.IntegrationEvents.Contracts.csproj"/>
        <ProjectReference Include="$(RepoRoot)KunstButikken.Common.Logging/KunstButikken.Common.Logging.csproj"/>
        <ProjectReference Include="$(RepoRoot)KunstButikken.ServiceDefaults/KunstButikken.ServiceDefaults.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Exclude Domain/Application/Infrastructure source files from the Web project to avoid duplicate compilation -->
        <Compile Remove="Domain\**\*.cs"/>
        <Compile Remove="Application\**\*.cs"/>
        <Compile Remove="Infrastructure\**\*.cs"/>
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>KunstButikken.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
