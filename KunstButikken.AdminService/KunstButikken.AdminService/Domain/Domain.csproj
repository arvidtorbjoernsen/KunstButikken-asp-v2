<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsSdkProject>true</IsSdkProject>
    <Description>Compatibility shim - use KunstButikken.AdminService.Domain.csproj as the canonical domain project.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Redirect to the canonical prefixed domain project to preserve existing relative references -->
    <ProjectReference Include="./KunstButikken.AdminService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prevent the shim from compiling local source files (they're compiled by the canonical project) -->
    <Compile Remove="**\*.cs" />
    <None Remove="**\*.cs" />
  </ItemGroup>

</Project>
