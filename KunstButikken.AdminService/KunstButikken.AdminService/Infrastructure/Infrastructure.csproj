<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsSdkProject>true</IsSdkProject>
    <Description>Compatibility shim - use KunstButikken.AdminService.Infrastructure.csproj as the canonical infrastructure project.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="./KunstButikken.AdminService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't compile local files in the shim to avoid duplicate symbols -->
    <Compile Remove="**\*.cs" />
    <None Remove="**\*.cs" />
  </ItemGroup>

</Project>
