<Configuration>
  <CodeCoverage>
    <Modules>
      <Include>
        <Module>KunstButikken.ArtService.dll</Module>
        <Module>KunstButikken.AuctionService.dll</Module>
        <Module>KunstButikken.PaymentService.dll</Module>
        <Module>KunstButikken.UserService.dll</Module>
        <Module>KunstButikken.AuthGateway.dll</Module>
        <Module>KunstButikken.AdminService.dll</Module>
      </Include>
      <Exclude>
        <Module>.*Tests.dll$</Module>
      </Exclude>
    </Modules>
  </CodeCoverage>
</Configuration>
